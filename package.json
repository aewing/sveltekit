{
	"name": "kit-monorepo",
	"version": "0.0.1",
	"description": "monorepo for @sveltejs/kit and friends",
	"private": true,
	"type": "module",
	"scripts": {
		"test:kit": "pnpm run --dir packages/kit test",
		"test:cross-platform:dev": "pnpm run --dir packages/kit test:cross-platform:dev",
		"test:cross-platform:build": "pnpm run --dir packages/kit test:cross-platform:build",
		"test:server-side-route-resolution:dev": "pnpm run --dir packages/kit test:server-side-route-resolution:dev",
		"test:server-side-route-resolution:build": "pnpm run --dir packages/kit test:server-side-route-resolution:build",
		"test:vite-ecosystem-ci": "pnpm --dir packages/kit test",
		"test:others": "pnpm -r --filter=./packages/* --filter=!./packages/kit/ test",
		"test:others:sync": "pnpm -r --filter=./packages/* --filter=!./packages/kit/ --workspace-concurrency=1 test",
		"check": "pnpm -r --workspace-concurrency=Infinity prepublishOnly && pnpm -r --workspace-concurrency=Infinity check",
		"check:sync": "pnpm -r --workspace-concurrency=1 prepublishOnly && pnpm -r --workspace-concurrency=1 check",
		"lint": "concurrently \"pnpm -r --workspace-concurrency=Infinity lint\" \"eslint --cache --cache-location node_modules/.eslintcache 'packages/**/*.js'\"",
		"lint:sync": "pnpm -r --workspace-concurrency=1 lint && eslint --cache --cache-location node_modules/.eslintcache 'packages/**/*.js'",
		"format": "pnpm -r --workspace-concurrency=Infinity format",
		"format:sync": "pnpm -r --workspace-concurrency=1 format",
		"precommit": "pnpm format && pnpm lint",
		"changeset:version": "changeset version && pnpm -r generate:version && git add --all",
		"changeset:release": "changeset publish",
		"build": "pnpm --filter @sveltejs/* -r --workspace-concurrency=Infinity build",
		"build:sync": "pnpm --filter @sveltejs/* -r --workspace-concurrency=1 build",
		"sync-all": "node scripts/sync-all.js"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.5",
		"@playwright/test": "catalog:",
		"@sveltejs/eslint-config": "^8.2.0",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"concurrently": "^9.1.2",
		"eslint": "^9.29.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"typescript-eslint": "^8.39.0"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"pnpm": ">=9.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild",
			"netlify-cli",
			"rolldown",
			"sharp",
			"svelte-preprocess",
			"unix-dgram",
			"workerd"
		]
	}
}
